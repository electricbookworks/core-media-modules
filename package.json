  "dependencies": {
    "@electricbookworks/core-ai-diagrams": "github:electricbookworks/core-ai-diagrams",
    "file-exists": "^5.0.1",
    "fs-extra": "^10.1.0",
    "gulp": "^4.0.2",
    "gulp-debug": "^4.0.0",
    "gulp-edit-xml": "^3.1.1",
    "gulp-gm": "^0.0.9",
    "gulp-if": "^3.0.0",
    "gulp-newer": "^1.4.0",
    "gulp-rename": "^1.4.0",
    "gulp-svgmin": "^2.2.0",
    "gulp-tap": "^2.0.0",
