    "url": "https://github.com/electricbookworks/core-media-modules/issues"
  },
  "homepage": "https://github.com/electricbookworks/core-media-modules#readme",
  "dependencies": {
    "cordova-android": "^8.0.0",
    "cordova-ios": "^5.0.1",
    "cordova-plugin-whitelist": "^1.3.3",
    "cordova-windows": "^7.0.0",
    "file-exists": "^5.0.1",
    "fs-extra": "^10.1.0",
    "gulp": "^4.0.2",
    "gulp-debug": "^4.0.0",
    "gulp-each": "^0.5.0",
    "gulp-edit-xml": "^3.1.1",
    "gulp-gm": "^0.0.9",
    "gulp-if": "^3.0.0",
    "gulp-mathjax-page": "github:arthurattwell/gulp-mathjax-page",
    "gulp-newer": "^1.4.0",
    "gulp-rename": "^1.4.0",
    "gulp-svgmin": "^2.2.0",
    "gulp-tap": "^2.0.0",
    "gulp-uglify": "^3.0.1",
    "js-yaml": "^3.13.1",
    "jszip": "^3.2.2",
    "make-runnable": "^1.3.8",
    "path": "^0.12.7",
    "puppeteer": "^24.43.1",
    "require-all": "^3.0.0",
    "yargs": "^15.3.1"
  },
  "prince": {
    "version": "books-20220701",
    "license": "_prince/license.dat"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-whitelist": {}
    },
    "platforms": [
