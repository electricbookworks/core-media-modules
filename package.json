{
  "name": "@electricbookworks/core-media-modules",
  "version": "1.0.0",
  "description": "A distributable package of modules used in CORE projects originally derived from the Electric Book Template.",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "node install.js",
    "first-release": "npx standard-version --first-release  && git push --follow-tags",
    "release": "standard-version && git push --follow-tags",
    "watch": "nodemon --ext js,mjs,cjs,json,scss --exec \"yalc push\""
  },
  "repository": {
